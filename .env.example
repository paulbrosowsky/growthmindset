# Claude API key (required for live AI; without it the app runs in script mode)
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5)
CLAUDE_MODEL=
# Optional: Postgres connection (Vercel Postgres / Neon). Without it, data is stored in .data/ as JSON files.
DATABASE_URL=
# OpenAI Realtime API for the voice conversation (Onboarding und Chat per Sprache). Server-side only;
# the browser gets a short-lived client secret from /api/realtime.
OPENAI_API_KEY=
# Optional overrides (defaults: gpt-realtime, marin, gpt-4o-mini-transcribe)
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
OPENAI_TRANSCRIBE_MODEL=
